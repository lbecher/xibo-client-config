set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $term alacritty
set $menu rofi -terminal '$term' -show combi -combi-modes drun

include /etc/sway/config-vars.d/*

output * resolution 1920x1080 position 1920,0

input * {
    xkb_layout "br"
}

#exec env ELECTRON_DISABLE_GPU=1 xibo-player --disable-gpu --disable-gpu-compositing --use-gl=swiftshader
exec xibo-player
for_window [class="xibo-player"] fullscreen enable

# Xibo
#bindsym $mod+x exec env ELECTRON_DISABLE_GPU=1 xibo-player --disable-gpu --disable-gpu-compositing --use-gl=swiftshader
#bindsym $mod+x exec xibo-player

bindsym $mod+t exec $term
bindsym $mod+f kill
bindsym $mod+m exec $menu
bindsym $mod+a exec pavucontrol
bindsym $mod+n exec thunar
bindsym $mod+i exec nm-connection-editor

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%"
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

floating_modifier $mod normal

bindsym $mod+Shift+d systemctl poweroff
bindsym $mod+Shift+r systemctl reboot
bindsym $mod+Shift+l reload
bindsym $mod+Shift+f exec swaynag -t warning -m 'Você realmente deseja fechar o Sway?' -B 'Sim, fechar o Sway' 'swaymsg exit'

# Move your focus around
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

include /etc/sway/config.d/*
